# Proveedor LLM por defecto (gemini | openai | openrouter | ollama)
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_LLM_MODEL=gemini-3.8-flash

# Google Gemini API Key
GEMINI_API_KEY=

# Opcionales para otros proveedores
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_URL=http://localhost:11434

# Tavily API key (opcional) — habilita búsqueda web enriquecida con Tavily
TAVILY_API_KEY=
